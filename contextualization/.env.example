# Copy to contextualization/.env (gitignored). Loaded by run_arm.py, build_dataset.py,
# eval_beliefs.py, analyze_beliefs.py, load_artifact_hf.py and scripts/base_train.py.
# Existing environment variables always win over values in this file.

# --- wandb: training / eval logs ---------------------------------------------------------
WANDB_API_KEY=
# WANDB_PROJECT=nanochat
# WANDB_ENTITY=danielaush

# --- Hugging Face Hub: checkpoints, tokenizer, probe sets, manifests, eval CSVs ----------
HF_TOKEN=
# HF_NAMESPACE=Daniele          # default: the token's user
# HF_PRIVATE=1                  # 0 = public repos (don't count against HF storage)

# --- global switch ------------------------------------------------------------------------
# CTX_TRACKING=0                # disable wandb + HF everywhere (smoke tests, CI)
